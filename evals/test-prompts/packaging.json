{
  "skill": "packaging",
  "version": "0.2.0",
  "source_book": "注意力与钩子：跨来源方法论汇编",
  "darwin_compatible": true,
  "minimum_pass_rate": 0.8,
  "notes": "边界题按「该答但需加限定」计为正例；判定口径见 evals/README.md。",
  "test_cases": [
    {
      "id": "should-trigger-01",
      "type": "should_trigger",
      "prompt": "这条视频播放很低，是标题封面不行还是内容不行？"
    },
    {
      "id": "should-trigger-02",
      "type": "should_trigger",
      "prompt": "帮我看看这个标题和封面怎么改。"
    },
    {
      "id": "should-trigger-03",
      "type": "should_trigger",
      "prompt": "封面用人物照还是产品截图？"
    },
    {
      "id": "should-trigger-04",
      "type": "should_trigger",
      "prompt": "标题和封面重复了同一个信息，要不要改？"
    },
    {
      "id": "should-not-01",
      "type": "should_not_trigger",
      "prompt": "帮我把这段 Python 改成异步。"
    },
    {
      "id": "should-not-02",
      "type": "should_not_trigger",
      "prompt": "明天北京下雨吗？"
    },
    {
      "id": "should-not-03",
      "type": "should_not_trigger",
      "prompt": "帮我把这段视频加字幕。"
    },
    {
      "id": "edge-01",
      "type": "edge_case",
      "prompt": "标题写得很炸但内容兑现不了，能发吗？"
    },
    {
      "id": "edge-02",
      "type": "edge_case",
      "prompt": "标题点击高但完播低，是包装问题吗？"
    }
  ]
}