{
  "skill": "hook-craft",
  "version": "0.2.0",
  "source_book": "注意力与钩子：跨来源方法论汇编",
  "darwin_compatible": true,
  "minimum_pass_rate": 0.8,
  "notes": "边界题按「该答但需加限定」计为正例；判定口径见 evals/README.md。",
  "test_cases": [
    {
      "id": "should-trigger-01",
      "type": "should_trigger",
      "prompt": "视频第一句怎么写才抓人，给个能照着改的流程。"
    },
    {
      "id": "should-trigger-02",
      "type": "should_trigger",
      "prompt": "这条钩子哪里不行，帮我逐条查一下。"
    },
    {
      "id": "should-trigger-03",
      "type": "should_trigger",
      "prompt": "帮我用六槽检查一下这个开头。"
    },
    {
      "id": "should-trigger-04",
      "type": "should_trigger",
      "prompt": "这句钩子读起来很平，怎么改？"
    },
    {
      "id": "should-not-01",
      "type": "should_not_trigger",
      "prompt": "把这段 Java 代码转成 Python。"
    },
    {
      "id": "should-not-02",
      "type": "should_not_trigger",
      "prompt": "这个月北京天气怎么样？"
    },
    {
      "id": "should-not-03",
      "type": "should_not_trigger",
      "prompt": "帮我把这段 C++ 编译一下。"
    },
    {
      "id": "edge-01",
      "type": "edge_case",
      "prompt": "能不能保证用了这个钩子模板播放量翻倍？"
    },
    {
      "id": "edge-02",
      "type": "edge_case",
      "prompt": "六槽都填满了，但读起来还是别扭，怎么办？"
    }
  ]
}