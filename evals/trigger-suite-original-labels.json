      "runs": 1
    },
    {
      "case_id": "gap-design-t-02",
      "prompt": "视频前 3 秒该说什么，才能让人不划走？",
      "expected": "should_trigger",
      "runs": 1
    },
    {
      "case_id": "gap-design-n-01",
      "prompt": "帮我把这段 Python 改成异步的。",
      "expected": "should_not_trigger",
      "runs": 1
    },
    {
      "case_id": "gap-design-n-02",
      "prompt": "这个月房贷利率是多少？",
